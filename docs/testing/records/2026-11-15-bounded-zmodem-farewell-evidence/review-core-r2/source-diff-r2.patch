+fn parity_padded_hex_finishes() -> Vec<Vec<u8>> {
+    let finish = header(FrameType::Finish, 0);
+    [
+        b"\xaa".as_slice(),
+        b"\xaa\xaa".as_slice(),
+        b"*\xaa".as_slice(),
+        b"\xaa*".as_slice(),
+        b"\xaa\xaa\xaa\xaa\xaa\xaa\xaa\xaa".as_slice(),
+    ]
+    .into_iter()
+    .map(|pads| [pads, &finish[2..]].concat())
+    .collect()
+}
