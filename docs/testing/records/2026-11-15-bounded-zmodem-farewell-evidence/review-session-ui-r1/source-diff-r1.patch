+                    .any(|event| matches!(event, ZmodemUiEvent::Finished { .. }))
+            );
+            if let Some(id) = warning {
+                assert!(protocol.safety.active.load(Ordering::Acquire));
+                protocol.resume_input(Uuid::new_v4());
+                assert!(protocol.safety.active.load(Ordering::Acquire));
+                protocol.resume_input(id);
