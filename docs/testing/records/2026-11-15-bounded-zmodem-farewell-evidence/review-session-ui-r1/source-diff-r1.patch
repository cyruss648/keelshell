+            let events = protocol.safety.take_events()?;
+            let warning = events.iter().find_map(|event| match event {
+                ZmodemUiEvent::EndedWithoutFarewell { id } => Some(*id),
+                _ => None,
+            });
+            assert_eq!(
+                warning.is_some(),
+                finish_sent && reply_state == 2 && exit_code == 0
+            );
+            assert!(
+                !events
