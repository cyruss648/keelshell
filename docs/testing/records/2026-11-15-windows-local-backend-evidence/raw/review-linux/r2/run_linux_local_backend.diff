+def validate_binary(integrity, elf, executable, toolchain):
+    """Bind an executable's recorded hash and ELF architecture to the native VM."""
+    match = re.fullmatch(r"([0-9a-f]{64})  " + re.escape(executable) + r"\n?", integrity)
+    machines = {"aarch64": "AArch64", "x86_64": "Advanced Micro Devices X86-64"}
+    machine = machines.get(toolchain.get("kernel_arch"))
+    fields = {}
+    for field in ("Class", "Data", "Type", "Machine"):
+        values = re.findall(r"^\s*" + field + r":\s+(.+)$", elf, re.MULTILINE)
+        if len(values) != 1:
+            raise BackendFailure("ELF header is missing or ambiguous: " + field)
+        fields[field] = values[0].strip()
+    if (not match or machine is None or fields["Class"] != "ELF64"
+            or fields["Data"] != "2's complement, little endian"
+            or fields["Type"].split()[0] not in ("DYN", "EXEC")
+            or fields["Machine"] != machine):
+        raise BackendFailure("Test executable hash or ELF architecture contradicts the native VM")
+    return {"sha256": match[1], "elf_class": fields["Class"], "machine": machine}
 
 
